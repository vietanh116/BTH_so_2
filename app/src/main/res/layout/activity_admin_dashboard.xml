<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <!-- Header: Tiêu đề, Nút xem đơn hàng và Nút Đăng xuất -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Admin Dashboard"
            android:textColor="#3BA2EB"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Nút Xem Đơn Hàng (Đây là nút đang bị thiếu gây lỗi) -->
        <Button
            android:id="@+id/btnViewOrders"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Orders"
            android:textAllCaps="false"
            android:backgroundTint="#4CAF50"
            android:layout_marginEnd="8dp" />

        <!-- Nút Đăng Xuất -->
        <Button
            android:id="@+id/btnLogoutAdmin"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:backgroundTint="#F44336"
            android:textAllCaps="false"
            android:text="Logout" />
    </LinearLayout>

    <!-- Thanh Tìm kiếm -->
    <EditText
        android:id="@+id/edtSearchAdmin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@id/headerLayout"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_rounded_edittext"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="8dp"
        android:hint="Search fruits..."
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:inputType="text" />

    <!-- Danh sách Trái cây -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvAdminFruits"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/edtSearchAdmin"
        android:layout_marginTop="16dp"
        android:clipToPadding="false"
        android:paddingBottom="80dp" />

    <!-- Nút thêm Trái cây (Floating Action Button) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnAddFruit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#3BA2EB"
        app:tint="#FFFFFF" />
</RelativeLayout>